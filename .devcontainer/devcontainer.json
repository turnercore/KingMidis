{
    "name": "kingmidis-dev",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "forwardPorts": [5000],

    "postCreateCommand": "cd \"$WORKSPACE_FOLDER\" && pip install -r requirements.txt",

    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "wholroyd.jinja",
                "samuelcolvin.jinjahtml"
            ]
        }
    },

    "remoteUser": "vscode"
}
